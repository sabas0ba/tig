# 開発環境に導入するツールの単一情報源。
#
# 本ファイルの内容は開発シェル (nix/devshell.nix) に反映される。ツールを追加する
# 場合は本ファイルのみを編集する。Rust toolchain は nix/toolchain.nix が定義する。
{ pkgs, toolchain }:

[ toolchain ]
++ (with pkgs; [
  # --- 基本ユーティリティ -------------------------------------------------
  coreutils
  findutils
  gnugrep
  gnused

  # --- タスクランナー -----------------------------------------------------
  gnumake

  # --- バージョン管理 -----------------------------------------------------
  # テスト (git との差分テスト) の実行にも必要
  git

  # --- 環境そのものを扱うツール -------------------------------------------
  direnv
  nix-direnv

  # --- Nix の開発支援 -----------------------------------------------------
  nixfmt
  statix
  deadnix
  nil
])
