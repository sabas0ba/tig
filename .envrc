# shellcheck shell=bash
#
# direnv が本ディレクトリで読み込む設定。`direnv allow` を一度実行すると、以降は
# cd するだけで開発環境に入る。

if ! has nix; then
  log_error "nix が見つかりません。README.md の手順で Nix を導入してください。"
  return 0
fi

# nix-direnv が無い場合も動作するが、cd のたびに flake を再評価するため遅くなる。
if ! has nix_direnv_version; then
  log_status "nix-direnv が未設定です。sabas0ba/dotfiles の 'direnv のセットアップ' を参照してください。"
fi

# 以下のファイルが変更された場合に開発シェルを再生成する。
watch_file flake.nix
watch_file flake.lock
watch_file nix/toolchain.nix
watch_file nix/devshell.nix
watch_file nix/packages.nix
watch_file nix/checks.nix

use flake .

# マシン固有の設定は .envrc.local に分離する。git 管理外。
source_env_if_exists .envrc.local
